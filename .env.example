# REQUIRED TO START. Values are examples/placeholders only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
FACEBOOK_PAGE_ID=

# OPTIONAL AUTHORIZATION BOUNDARY.
TELEGRAM_ALLOWED_USER_IDS=

# FACEBOOK PUBLISHING / RECONNECT (feature-specific secrets where noted).
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# HTTP / MANAGED RUNTIME. PORT is normally supplied by the platform.
ADMIN_DASHBOARD_ENABLED=true
ADMIN_DASHBOARD_HOST=127.0.0.1
ADMIN_DASHBOARD_PORT=8787
ADMIN_DASHBOARD_SECRET=
PORT=
WEATHERWATCH_RUNTIME_ROOT=

# STATE: filesystem is the local default; redis requires the secret URL.
WEATHERWATCH_STATE_BACKEND=filesystem
WEATHERWATCH_REDIS_URL=

# EDITORIAL: templated works without provider credentials.
WEATHERWATCH_EDITORIAL_MODE=templated
WEATHERWATCH_AI_OPENROUTER_ENABLED=false
WEATHERWATCH_AI_OPENROUTER_MODEL=
WEATHERWATCH_AI_OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
WEATHERWATCH_AI_PROVIDER_2_ENABLED=false
WEATHERWATCH_AI_PROVIDER_2_MODEL=
WEATHERWATCH_AI_PROVIDER_2_TIMEOUT_SECONDS=30
AI_PROVIDER_2_API_KEY=
AI_PROVIDER_2_BASE_URL=
WEATHERWATCH_AI_PROVIDER_3_ENABLED=false
WEATHERWATCH_AI_PROVIDER_3_MODEL=
WEATHERWATCH_AI_PROVIDER_3_TIMEOUT_SECONDS=30
AI_PROVIDER_3_API_KEY=
AI_PROVIDER_3_BASE_URL=
WEATHERWATCH_AI_OPENAI_ENABLED=false
WEATHERWATCH_AI_OPENAI_MODEL=
WEATHERWATCH_AI_OPENAI_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_BASE_URL=
